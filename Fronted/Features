    <section>
        <h2>Explore the Features</h2>
        <div class="features-container">
            <div class="feature-card" onclick="openHolidaysModal()">
                <img src="https://images.unsplash.com/photo-1517685352821-92cf88aee5a5" alt="Holidays">
                <h3>Holidays</h3>
                <p>A comprehensive calendar displaying all public and academic holidays for planning ahead.</p>
            </div>
            <div class="feature-card" onclick="openTravelModal()">
                <img src="https://images.unsplash.com/photo-1521737604893-d14cc237f11d" alt="Travel Info">
                <h3>Travel Info</h3>
                <p>Get updated train and bus timings, routes, and schedules for convenient travel planning.</p>
            </div>
        </div>
    </section>

    <div class="modal" id="holidaysModal">
        <div class="modal-content">
            <h2>Public Holidays - <span id="currentYear"></span></h2>
            <ul id="holidaysList"></ul>
            <a href="https://www.india.gov.in/calendar" target="_blank">View Full Holiday Calendar</a>
            <button class="close-btn" onclick="closeHolidaysModal()">Close</button>
        </div>
    </div>

    <div class="modal" id="travelModal">
        <div class="modal-content">
            <h2>Available Trains & Buses</h2>
            <ul>
                <li>Train: Express 123 - 10:00 AM</li>
                <li>Train: Intercity 456 - 02:30 PM</li>
                <li>Bus: City Bus 22 - Every 30 mins</li>
                <li>Bus: Express Coach - 05:00 PM</li>
            </ul>
            <button class="close-btn" onclick="closeTravelModal()">Close</button>
        </div>
    </div>

    <script>
        function openHolidaysModal() {
            document.getElementById('holidaysModal').style.display = 'flex';
            const year = new Date().getFullYear();
            document.getElementById('currentYear').textContent = year;
        }

        function closeHolidaysModal() {
            document.getElementById('holidaysModal').style.display = 'none';
        }

        function openTravelModal() {
            document.getElementById('travelModal').style.display = 'flex';
        }

        function closeTravelModal() {
            document.getElementById('travelModal').style.display = 'none';
        }
    </script>
