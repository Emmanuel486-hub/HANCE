<!DOCTYPE html>
<html lang="en">

<head>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Student Support</title>
    <style>
        /* General Styles */
        @import url('https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;700&display=swap');
        body {
            font-family: 'Roboto', sans-serif;
            margin: 0;
            padding: 0;
            background: linear-gradient(135deg, #e8f5e9, #ffffff);
            color: #333;
        }
        
        header {
            background-color: #000;
            color: white;
            padding: 20px 30px;
            text-align: center;
        }
        
        header h1 {
            margin: 0;
            font-size: 2.5em;
            font-weight: 700;
            letter-spacing: 1px;
        }
        
        section {
            padding: 60px 20px;
        }
        
        h2 {
            text-align: center;
            margin-bottom: 40px;
            font-size: 2.5em;
            color: #00a8ff;
        }
        
        .support-container {
            max-width: 1200px;
            margin: 0 auto;
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
            gap: 30px;
        }
        
        .support-item {
            background: white;
            border-radius: 15px;
            padding: 30px;
            box-shadow: 0 8px 20px rgba(0, 0, 0, 0.15);
            transition: transform 0.3s ease, box-shadow 0.3s ease;
        }
        
        .support-item:hover {
            transform: translateY(-12px);
            box-shadow: 0 15px 35px rgba(0, 0, 0, 0.25);
        }
        
        .support-item img {
            width: 100%;
            height: 220px;
            object-fit: cover;
            border-radius: 12px;
            margin-bottom: 20px;
        }
        
        .support-item h3 {
            margin-bottom: 15px;
            font-size: 2em;
            color: #00a8ff;
        }
        
        .support-item p,
        .support-item ul {
            font-size: 1.2em;
            color: #555;
        }
        
        .support-item ul {
            list-style: disc;
            padding-left: 25px;
        }
        
        footer {
            text-align: center;
            padding: 20px 0;
            background: #00a8ff;
            color: white;
            font-size: 1.2em;
        }
        
        footer a {
            color: #00a8ff;
            text-decoration: none;
        }
        
        footer a:hover {
            text-decoration: underline;
        }
        
        .navbar {
            display: flex;
            gap: 70px;
            background-color: #333;
            font-family: 'Space Grotesk', sans-serif;
        }

        .navbar a {
            color: white;
            text-decoration: none;
            padding: 10px 15px;
        }
        .navbar a.active,
        .navbar a:hover {
            background: #00a8ff;
            color: #000;
        }

        /* Styles for the form */
        .form-group {
            margin-bottom: 15px;
        }

        .form-group label {
            display: block;
            margin-bottom: 5px;
        }

        .form-group input,
        .form-group textarea {
            width: 100%;
            padding: 10px;
            border: 1px solid #ccc;
            border-radius: 5px;
        }

        .form-group button {
            background-color: #00a8ff;
            color: white;
            border: none;
            padding: 10px 15px;
            border-radius: 5px;
            cursor: pointer;
        }

        .form-group button:hover {
            background-color: #008bbf;
        }

        .submitted-details {
            margin-top: 20px;
            padding: 10px;
            background-color: #f0f0f0;
            border-radius: 5px;
        }
    </style>
</head>

<body>
    <header>
        <h1>Student Support</h1>
    </header>
    <header class="navbar">
        <nav class="navbar">
            <a href="homePage.html"><i class="fas fa-home"></i> Home</a>
            <a href="Essential_Features_1.html"><i class="fas fa-star"></i>  Features</a>
            <a href="#" class="active"><i class="fas fa-user-graduate"></i>Support</a>
            <a href="Academic_Support.html"><i class="fas fa-book"></i> Resources</a>
            <a href="Events.html"><i class="fas fa-calendar-alt"></i> Events</a>
            <a href="mess_and_food.html"><i class="fas fa-utensils"></i> Mess</a>
            <a href="Contact_1.html"><i class="fas fa-envelope"></i> Contact</a>
        </nav>
    </header>

    <section>
        <h2>Student Support Services</h2>
        <div class="support-container">
            <!-- Lost and Found -->
            <div class="support-item">
                <img src="https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcRbOEi3IIeRrCwNm2kC-u13xS3RyucWME29Ng&s" alt="Lost and Found">
                <h3>Lost and Found</h3>
                <p>Report or retrieve items you've misplaced via the <strong>"Missed Things"</strong> section.</p>
                <form id="lost-item-form">
                    <div class="form-group">
                        <label for="item-name">Item Name:</label>
                        <input type="text" id="item-name" name="item-name" required>
                    </div>
                    <div class="form-group">
                        <label for="item-description">Description:</label>
                        <textarea id="item-description" name="item-description" required></textarea>
                    </div>
                    <div class="form-group">
                        <label for="contact-info">Your Contact Info:</label>
                        <input type="text" id="contact-info" name="contact-info" required>
                    </div>
                    <div class="form-group">
                        <button type="submit">Submit</button>
                    </div>
                </form>
                <div id="submitted-details" class="submitted-details"></div>
            </div>
            <!-- Hostel Support -->
            <div class="support-item">
                <img src="https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcSooqHgLvE-dsw6aBPhzhNuqTs81831RYCuLA&s" alt="Hostel Support">
                <h3>Hostel Support</h3>
                <ul>
                    <li>Submit complaints or requests regarding hostel problems.</li>
                    <li>Find contact details for your hostel warden.</li>
                    <li><strong>Hostel Warden Name:</strong> Kishore</li>
                    <li><strong>Phone Number:</strong> 8833445522</li>
                </ul>
            </div>
        </div>
    </section>
    <footer>
        &copy; 2025 Student Support | Designed with 💚 by HANCE<a href="#">Team HANCE</a>
    </footer>

    <script>
        document.getElementById('lost-item-form').addEventListener('submit', function(event) {
            event.preventDefault(); // Prevent the default form submission
            
            const itemName = document.getElementById('item-name').value;
            const itemDescription = document.getElementById('item-description').value;
            const contactInfo = document.getElementById('contact-info').value;

            // Create a new div to display the submitted details
            const submittedDetailsDiv = document.getElementById('submitted-details');
            submittedDetailsDiv.innerHTML = `
                <h4>Submitted Details:</h4>
                <p><strong>Item Name:</strong> ${itemName}</p>
                <p><strong>Description:</strong> ${itemDescription}</p>
                <p><strong>Contact Info:</strong> ${contactInfo}</p>
            `;
            
            // Optionally, you can reset the form after submission
            this.reset();
        });
    </script>
</body>

</html>
