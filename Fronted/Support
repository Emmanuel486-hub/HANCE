        }
        
        .support-item:hover {
            transform: translateY(-12px);
            box-shadow: 0 15px 35px rgba(0, 0, 0, 0.25);
        }
        
        .support-item img {
            width: 100%;
            height: 220px;
            object-fit: cover;
            border-radius: 12px;
            margin-bottom: 20px;
        }
        
        .support-item h3 {
            margin-bottom: 15px;
            font-size: 2em;
            color: #00a8ff;
        }
        
        .support-item p,
        .support-item ul {
            font-size: 1.2em;
            color: #555;
        }
        
        .support-item ul {
            list-style: disc;
            padding-left: 25px;
        }
        
        footer {
            text-align: center;
            padding: 20px 0;
            background: #00a8ff;
            color: white;
            font-size: 1.2em;
        }
        
        footer a {
            color: #00a8ff;
            text-decoration: none;
        }
        
        footer a:hover {
            text-decoration: underline;
        }
        
